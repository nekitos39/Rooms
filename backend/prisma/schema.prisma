// Prisma schema — MariaDB / MySQL
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Сушность User
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

// Модель для Аудитории
model Room {
  id        String    @id @default(cuid())
  name      String
  number    String    @unique
  capacity  Int
  features  String    @default("[]") // JSON-строка, например "[\"projector\",\"whiteboard\"]"
  status    String    @default("available")
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

// Модель для Брони
model Booking {
  id        String   @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  notes     String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  createdAt DateTime @default(now())
}